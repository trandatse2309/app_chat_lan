<Window x:Class="LAN_Network_Chat_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LAN Chat" Height="540" Width="860"
        Background="#1e1e2e"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#7c3aed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,9"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6d28d9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5b21b6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3a3a55"/>
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2d2d44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a3a55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input TextBox — fix text clipping bằng cách dùng Margin thay Padding trong ScrollViewer -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2d2d44"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="CaretBrush" Value="#e2e8f0"/>
            <Setter Property="SelectionBrush" Value="#7c3aed"/>
            <Setter Property="BorderBrush" Value="#3a3a55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7c3aed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ================= START PANEL ================= -->
        <StackPanel x:Name="StartPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="340">

            <TextBlock Text="LAN Chat"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#7c3aed"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Kết nối với các thiết bị trong mạng LAN"
                       FontSize="12"
                       Foreground="#64748b"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <!-- Tên của bạn -->
            <TextBlock Text="Tên của bạn" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox"
                     Style="{StaticResource InputBox}"
                     Height="40"
                     Margin="0,0,0,20"/>

            <!-- HOST -->
            <Button Content="Tạo phòng (HOST)"
                    Style="{StaticResource PrimaryButton}"
                    Height="44"
                    Margin="0,0,0,12"
                    Click="Host_Click"/>

            <!-- Divider -->
            <Grid Margin="0,4,0,12">
                <Separator Background="#2d2d44" VerticalAlignment="Center"/>
                <TextBlock Text="  hoặc tham gia phòng  "
                           Foreground="#64748b"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Background="#1e1e2e"
                           Padding="8,0"/>
            </Grid>

            <!-- IP -->
            <TextBlock Text="Địa chỉ IP của host" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="IpBox"
                     Style="{StaticResource InputBox}"
                     Text="127.0.0.1"
                     Height="40"
                     Margin="0,0,0,10"/>

            <Button Content="Tham gia phòng (JOIN)"
                    Style="{StaticResource SecondaryButton}"
                    Height="44"
                    Click="Join_Click"/>

        </StackPanel>

        <!-- ================= CHAT PANEL ================= -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: Chat ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="#16162a"
                        BorderBrush="#2d2d44" BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="#22c55e" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoomLabel"
                                       Foreground="#e2e8f0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="ModeLabel"
                                       Foreground="#7c3aed"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <!-- Nút xem IP — chỉ hiện khi HOST -->
                            <Button x:Name="ShowIpButton"
                                    Content="📋 IP"
                                    Visibility="Collapsed"
                                    Cursor="Hand"
                                    Background="#2d2d44"
                                    Foreground="#94a3b8"
                                    BorderThickness="0"
                                    FontSize="11"
                                    Padding="8,4"
                                    Click="ShowIpButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3a3a55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Popup danh sách IP -->
                            <Popup x:Name="IpPopup"
                                   PlacementTarget="{Binding ElementName=ShowIpButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="#1e1e2e"
                                        BorderBrush="#3a3a55"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        MinWidth="260">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Địa chỉ IP của máy bạn"
                                                   Foreground="#64748b"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8"/>
                                        <StackPanel x:Name="IpList"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages -->
                <ScrollViewer Grid.Row="1"
                              x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,10">
                    <StackPanel x:Name="ChatList"/>
                </ScrollViewer>

                <!-- Input -->
                <Border Grid.Row="2" Background="#16162a"
                        BorderBrush="#2d2d44" BorderThickness="0,1,0,0"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageInput"
                                 Grid.Column="0"
                                 Style="{StaticResource InputBox}"
                                 Height="40"
                                 KeyDown="MessageInput_KeyDown"/>

                        <Button Content="Gửi"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Width="76"
                                Height="40"
                                Margin="8,0,0,0"
                                Click="Send_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== RIGHT: Users ===== -->
            <Border Grid.Column="1" Background="#16162a"
                    BorderBrush="#2d2d44" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="14,0"
                            BorderBrush="#2d2d44" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ONLINE"
                                       Foreground="#64748b"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="OnlineCountBadge"
                                    Background="#2d2d44"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Margin="8,0,0,0">
                                <TextBlock x:Name="OnlineCount"
                                           Text="1"
                                           Foreground="#94a3b8"
                                           FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- User list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UserList" Margin="8,8,8,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
